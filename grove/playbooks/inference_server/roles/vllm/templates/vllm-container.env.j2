{#
  docker --env-file format: one KEY=value per line, NO quoting — the value is the rest of
  the line verbatim. Model Deployment validates keys and rejects newlines in values, which
  is what keeps that true. The file, not the argv, carries the secrets: `docker run -e K=v`
  would put them in every local user's `ps`.
#}
{#
  Compile caches live under the /root/.cache/vllm mount (see the run script), so kernels
  survive container replaces. First, so a deployment env row can override them.
#}
TRITON_CACHE_DIR=/root/.cache/vllm/triton
TORCHINDUCTOR_CACHE_DIR=/root/.cache/vllm/torchinductor
{% if vllm_predownload_model and not vllm_download_glob %}
{#
  The pre-download task owns the weights, and its guard stops at the repo — so `main` moving
  upstream leaves the box's copy alone. Without this the engine resolves `main` itself and
  fetches the new revision inline, under the health gate: a deploy that changed nothing
  silently serves different weights, or runs out of VRAM loading them. Offline means the
  cached snapshot is what runs. Not set for a GGUF ref, whose download is one file — the
  config and tokenizer beside it are still fetched at boot.
#}
HF_HUB_OFFLINE=1
{% endif %}
{% for key, value in vllm_env.items() %}
{{ key }}={{ value }}
{% endfor %}
{% if vllm_effective_api_key | length > 0 %}
VLLM_API_KEY={{ vllm_effective_api_key }}
{% endif %}
