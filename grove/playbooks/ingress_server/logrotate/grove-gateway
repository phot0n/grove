# The per-request access line. The process log goes to journald, which has its own rotation — this
# is only the file the gateway writes itself.
#
# copytruncate rather than a signal: the three signals grove-gateway takes all mean something else
# (upgrade, reload, drain), and inventing a fourth so logrotate can reopen a file is not worth it.
# The cost is that a write landing during the copy can be lost; for an access log, one line under
# rotation is cheaper than a signal that means two things.
/var/log/grove-gateway/access.log {
	daily
	rotate 14
	missingok
	notifempty
	compress
	delaycompress
	copytruncate
	su root root
}
