# The two files the gateway writes itself: the per-request access line, and warnings and worse
# mirrored out of the process log. The rest of the process log goes to journald, which rotates itself.
#
# create rather than copytruncate: pathway's log writer follows the rename itself (it reopens
# the path when the inode moves), so no signal is needed — and copytruncate both loses whatever
# lands during the copy and truncates the inode a log collector is still reading from.
/var/log/pathway/access.log
/var/log/pathway/error.log {
	daily
	rotate 14
	missingok
	notifempty
	compress
	delaycompress
	create 0640 frappe frappe
	su frappe frappe
}
