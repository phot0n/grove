[Unit]
Description=Pathway — the Grove data plane (TLS, auth, routing, metering)
After=network-online.target redis-server.service
Wants=network-online.target redis-server.service

[Service]
ExecStart=/usr/local/bin/pathway
# SIGHUP is the upgrade: a child inherits the listening sockets and starts serving while this
# process drains behind it, so `systemctl reload` after a binary copy drops no connections. A binary
# that fails to start leaves this one serving.
ExecReload=/bin/kill -HUP $MAINPID

# An upgrade changes the PID, and this is how systemd follows it: it re-reads the file when the main
# process exits and adopts whatever pid is in it. tableflip writes the file at Ready(), which is
# both the vendor's documented systemd integration and what makes the sd_notify handshake
# unnecessary — no Type=notify, no NotifyAccess=all.
#
# It MUST match GROVE_PID_FILE in agent.env. They drift and the handover breaks silently: systemd
# keeps pointing at the process that exited, so the next `systemctl reload` signals nothing.
PIDFile=/run/pathway.pid

KillSignal=SIGTERM
# Longer than the drain (630s default) plus its lame-duck window, so systemd never SIGKILLs a
# process that is shutting down correctly. A streaming completion legitimately takes minutes.
TimeoutStopSec=700
Restart=on-failure
RestartSec=2

# Binds 80 and 443 without running as root for anything else. The capability is only needed for the
# very first bind — an upgrade inherits the sockets rather than rebinding them.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
LimitNOFILE=65536

EnvironmentFile=-/etc/pathway/agent.env

[Install]
WantedBy=multi-user.target
