[Unit]
Description=Grove gateway Go agent (decide + meter brain)
After=network-online.target redis-server.service
Wants=network-online.target redis-server.service

[Service]
Type=simple
ExecStart=/usr/local/bin/grove-gateway
Environment=GROVE_AGENT_ADDR=127.0.0.1:9090
Environment=GROVE_REDIS_ADDR=127.0.0.1:6379
EnvironmentFile=-/etc/grove-gateway/agent.env
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
