{#
  docker --env-file format: one KEY=value per line, NO quoting — the value is the rest of
  the line verbatim. Model Deployment validates keys and rejects newlines in values, which
  is what keeps that true. The file, not the argv, carries the secrets: `docker run -e K=v`
  would put them in every local user's `ps`.
#}
{% for key, value in vllm_env.items() %}
{{ key }}={{ value }}
{% endfor %}
{% if vllm_effective_api_key | length > 0 %}
VLLM_API_KEY={{ vllm_effective_api_key }}
{% endif %}
