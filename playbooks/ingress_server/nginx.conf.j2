{#
  Grove ingress — OpenResty in front of one VPC's engines. Rendered by ingress.yml and
  deploy_openresty.yml; do not edit on the box.

  Two names, mirroring the gateway's split and for the same reason. The Network's shared name is
  what the gateways dial, and DNS hands out whichever ingress in the Network is healthy — so it
  must never carry /grove-admin, which has to reach ONE box to push it a replica table. This box's
  own <name>.<zone> carries that, and the metrics scrape with it.

  The data path itself is not here yet: until the agent has an ingress mode and the route table is
  split, an ingress answers /healthz and takes its replica table, and no traffic is pointed at it.
  Provisioning one early is safe precisely because nothing resolves to it that is not asked for.
#}
{% set tls = ingress_hostname and fleet_tls_cert %}
{% set certificate = fleet_tls_cert_path if tls else grove_tls_cert %}
{% set certificate_key = fleet_tls_key_path if tls else grove_tls_key %}
{% macro healthz() %}
		# Answered on every name this box has: the Route53 health check behind the shared record
		# asks for it by this box's own name, and a gateway checks the shared one.
		location = /healthz {
			content_by_lua_block { ngx.say("ok") }
		}
{% endmacro %}
{% macro admin_locations() %}
		# Control-plane replica-table push → Go agent (token-gated inside the agent).
		location /grove-admin/ {
			proxy_pass http://127.0.0.1:9090/admin/;
			proxy_read_timeout 30s;
		}
{% endmacro %}
{% macro metrics_locations() %}
		# No GPU target here — an ingress box has no cards.
		location = /metrics/node {
			auth_basic "grove metrics";
			auth_basic_user_file /etc/grove/nginx/metrics.htpasswd;
			proxy_pass http://127.0.0.1:9100/metrics;
		}
{% endmacro %}
worker_processes auto;
error_log /var/log/openresty/error.log warn;

events {
	worker_connections 8192;
}

http {
	lua_package_path "/etc/grove-gateway/lua/?.lua;;";
	lua_need_request_body on;
	client_body_buffer_size 8m;
	client_max_body_size 32m;
	default_type application/json;

	# Off until there is a data path to log. What this box serves today is /healthz, asked by
	# every Route53 health checker every 30 seconds, and nothing is learned from recording it.
	# The access log arrives with the data path, in the gateway's format and keyed on the same
	# X-Request-Id — correlating gateway → ingress → vLLM is one grep across three logs, and that
	# only works while the three agree on the shape.
	access_log off;

{% if tls %}
	# Nothing but the redirect. No ACME challenge location: the fleet certificate is issued on the
	# control plane over DNS-01.
	server {

		listen 80 default_server;
		server_name _;

{{ healthz() }}
		location / {
			return 301 https://$host$request_uri;
		}

	}

	# The Network's shared name. Every ingress in the Network answers to it with the same
	# wildcard certificate, and DNS picks one — which is safe only because every ingress holds
	# the identical replica table and hashes a session the same way.
	server {

		listen 443 ssl;
		http2 on;
		server_name {{ ingress_host }};

		ssl_certificate     {{ certificate }};
		ssl_certificate_key {{ certificate_key }};

{{ healthz() }}
	}

	# This box specifically. /grove-admin has to reach ONE ingress — the shared name above names
	# them all — and admin_url on the Ingress Server doc is this name, verified against the same
	# wildcard.
	#
	# default_server so the Monitoring Agent's scrape, which connects to the bare IP and sends no
	# SNI, still lands on /metrics/node.
	server {

		listen 443 ssl default_server;
		server_name {{ ingress_hostname }};

		ssl_certificate     {{ certificate }};
		ssl_certificate_key {{ certificate_key }};

{{ healthz() }}
{{ admin_locations() }}
{{ metrics_locations() }}
	}
{% else %}
	server {

		listen 80 default_server;
		server_name _;

{{ healthz() }}
{{ admin_locations() }}
	}

	# Metrics only, on their own TLS listener: basic auth over plaintext would put the scrape
	# password on the wire every 15 seconds. The certificate and htpasswd come from grove_https.
	server {
		listen 443 ssl default_server;
		server_name _;

		ssl_certificate     {{ certificate }};
		ssl_certificate_key {{ certificate_key }};

{{ metrics_locations() }}
	}
{% endif %}
}
